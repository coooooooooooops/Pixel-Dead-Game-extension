{
  "manifest_version": 3,
  "name": "Pixel Dead",
  "version": "2.3.0",
  "description": "Pixel-art zombie survival with bosses, 14 weapons and online co-op, PvP and hide and seek. Play in the popup or a full tab.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Play Pixel Dead",
    "default_popup": "game.html?popup=1",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
